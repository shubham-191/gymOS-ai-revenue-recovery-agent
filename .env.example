# ==============================================================================
# GymOS AI Revenue Recovery Engine — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Razorpay API Credentials (Test Mode)
# Leave empty or set to 'mock' to run in full deterministic simulation mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Diagnostic Provider ('openai', 'gemini', or 'mock_heuristic')
# If no LLM key is provided, the engine seamlessly uses the calibrated heuristic diagnostician
LLM_PROVIDER=mock_heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=

# Policy Guardrails Defaults
MAX_DISCOUNT_PERCENT=15.0
MAX_RECOVERY_ATTEMPTS=3
MIN_COOLDOWN_HOURS=24
VIP_ESCALATION_THRESHOLD_INR=50000.0
